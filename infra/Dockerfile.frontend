FROM node:20-alpine
WORKDIR /app

COPY apps/frontend/software/mavingue/package.json apps/frontend/software/mavingue/package-lock.json* ./
RUN npm install --no-audit --no-fund

COPY apps/frontend/software/mavingue/. .

ENV PORT=3000
EXPOSE 3000
CMD ["npm", "run", "dev", "--", "--hostname", "0.0.0.0", "--port", "3000"]
